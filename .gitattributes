# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout (LF on Unix, CRLF on Windows)
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Lock files should always use LF
package-lock.json text eol=lf
yarn.lock text eol=lf

# Binary files (these are set to binary so Git won't modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.jar binary
*.class binary
*.so binary
*.dylib binary
*.keystore binary

# Compiled files
*.jar binary
*.zip binary
*.tar binary
*.tgz binary

