# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Aifood' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # ✅ iOS Build Optimizations for Smaller IPA Size
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.name == 'Release'
          # ✅ Enable aggressive optimization
          config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-O'
          config.build_settings['GCC_OPTIMIZATION_LEVEL'] = 's' # Size optimization
          
          # ✅ Strip debug symbols
          config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'YES'
          config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'YES'
          config.build_settings['COPY_PHASE_STRIP'] = 'YES'
          
          # ✅ Remove unused code
          config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
          
          # ✅ Compress PNGs
          config.build_settings['COMPRESS_PNG_FILES'] = 'YES'
          
          # ✅ Single architecture for release (if needed)
          # config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        end
      end
    end
    
    # ✅ Optimize main app target
    installer.aggregate_targets.each do |target|
      target.xcconfigs.each do |config_name, config_file|
        if config_name.include?('Release')
          config_file.attributes['SWIFT_OPTIMIZATION_LEVEL'] = '-O'
          config_file.attributes['GCC_OPTIMIZATION_LEVEL'] = 's'
        end
      end
    end
  end
end
